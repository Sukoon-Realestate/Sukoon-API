# ==============================================================================
# Sukoon Frontend Environment Configuration Template
# ==============================================================================

# Backend Connection Switch
# - Set to 'false' to use local static dummy JSON data (when backend is not deployed).
# - Set to 'true' to connect to live Django REST API backend.
NEXT_PUBLIC_ENABLE_BACKEND=true

# Django Backend API Base URL (used when NEXT_PUBLIC_ENABLE_BACKEND=true)
# Same-origin browser requests, forwarded only to this server-configured origin.
SOKOUN_API_PROXY_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=
