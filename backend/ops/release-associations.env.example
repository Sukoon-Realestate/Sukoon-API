# Local preparation only. Do not deploy until real release identities are verified.
# Colon-separated SHA-256 hex octets; multiple fingerprints are comma-separated.
# For Play-distributed apps use the Play App Signing certificate, not merely the
# upload key or a local debug keystore. Leave unverified identities empty.
SOKOUN_ANDROID_PROD_SHA256_FINGERPRINTS=
SOKOUN_ANDROID_DEV_SHA256_FINGERPRINTS=
# Apple Developer team identifier from the actual distribution profile.
SOKOUN_APPLE_TEAM_ID=
