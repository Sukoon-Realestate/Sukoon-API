# Backend only. Copy values into backend/.envs/.env.local or deployment secrets.
PROPERTY_CAPTURE_ENABLED=false
GEMINI_API_KEY=
GEMINI_COACH_MODEL=gemini-3.8-live
COACH_DAILY_SESSION_LIMIT=10
CAPTURE_MAX_SESSION_BYTES=536870912
CAPTURE_RETENTION_DAYS=30
# Private storage uses existing VIRTUAL_TOUR_* settings. Never use MEDIA_URL.
# GPU reconstruction is not implemented in this development profile.
# No environment variable can turn this into a validated 3D pipeline.
