{
  "name": "sukoon-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pipenv run python scripts/dev.py",
    "dev:seed": "pipenv run python scripts/dev.py --seed",
    "dev:reset": "pipenv run python scripts/dev.py --reset",
    "seed": "pipenv run python manage.py seed_db --settings=config.settings.local_sqlite",
    "test": "pipenv run pytest",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  }
}
